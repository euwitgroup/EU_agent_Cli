# MyAgent Configuration

# Provider selection: openai, anthropic, custom
MYAGENT_PROVIDER=anthropic

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Custom Provider Configuration (OpenAI-compatible)
CUSTOM_API_KEY=your-custom-api-key-here
CUSTOM_BASE_URL=https://your-provider.com/v1
CUSTOM_MODEL=your-model-name

# Agent Configuration
MYAGENT_MAX_ITERATIONS=50
MYAGENT_COMMAND_TIMEOUT=120
MYAGENT_AUTO_APPROVE_READS=true

# API Retry Configuration (for handling rate limits)
MYAGENT_MAX_RETRIES=3
MYAGENT_INITIAL_RETRY_DELAY=1.0
MYAGENT_MAX_RETRY_DELAY=60.0

# Logging
MYAGENT_LOG_LEVEL=INFO
